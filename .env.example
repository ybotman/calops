# Azure Functions Backend (PRIMARY)
NEXT_PUBLIC_AF_ENABLED=true
NEXT_PUBLIC_AF_URL=http://localhost:7071

# Legacy Express Backend (DEPRECATED - no longer running)
# NEXT_PUBLIC_BE_URL=http://localhost:3010

# Google Maps API Key for Geocoding
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable "Geocoding API" in the Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Alternative geocoding providers
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
# OPENCAGE_API_KEY=your_opencage_key_here
