# Copy this file to .env.local and fill in your API keys

# Azure Functions Backend (PRIMARY)
NEXT_PUBLIC_AF_ENABLED=true
NEXT_PUBLIC_AF_URL=http://localhost:7071

# Legacy Express Backend (DEPRECATED - no longer running)
# NEXT_PUBLIC_BE_URL=http://localhost:3010

# Google Maps API Key for Geocoding
# To get your API key:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project or select existing
# 3. Enable "Geocoding API" in APIs & Services
# 4. Create credentials (API Key)
# 5. Restrict the key to your domains (optional but recommended)
GOOGLE_MAPS_API_KEY=your_actual_google_maps_api_key_here
